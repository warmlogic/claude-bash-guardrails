{
  "description": "PreToolUse hook for Bash commands: denies zsh traps with a one-line fix; never allows or rewrites",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/bash-guardrails.sh\""
          }
        ]
      }
    ]
  }
}
